---
---
[
  {% for post in site.recipes %}
    {
      "id"          : "{{ forloop.index0 }}",
      "title"       : "{{ post.title | escape }}",
      "ingredients" : "{% for ingredient in post.ingredients %}{{ ingredient | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}",
      "tags"        : "{% for tag in post.tags %}{{ tag | strip | escape }} {% endfor %}",
      "image"       : "{{ site.baseurl }}/images/{{ post.image }}",
      "url"         : "{{ site.baseurl }}{{ post.url }}",
      "description" : "{{ post.content | strip_html | replace: '"', '' | replace: "'", '' | strip_newlines | truncate: 200 }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]

